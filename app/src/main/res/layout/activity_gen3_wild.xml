<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/editTextSeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Seed"
            android:inputType="number" />

        <EditText
            android:id="@+id/editTextInitialAdvances"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Initial Advances"
            android:inputType="number" />

        <EditText
            android:id="@+id/editTextMaxAdvances"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Max Advances"
            android:inputType="number" />

        <CheckBox
            android:id="@+id/checkBoxFeebas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Feebas Tile" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Encounter Type:"
            android:layout_marginTop="8dp"/>

        <Spinner
            android:id="@+id/spinnerEncounter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:onClick="onGetEncounterClick"
            android:text="Generate Wild Encounters" />

    </LinearLayout>
</ScrollView>
